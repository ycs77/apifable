{
  "name": "apifable",
  "version": "1.3.0",
  "description": "MCP server that helps AI agents explore OpenAPI specs, search endpoints, and generate TypeScript types.",
  "keywords": [
    "agent",
    "agentic",
    "ai",
    "api",
    "llm",
    "mcp",
    "modelcontextprotocol",
    "openapi",
    "types",
    "typescript"
  ],
  "homepage": "https://github.com/ycs77/apifable",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ycs77/apifable.git"
  },
  "bin": {
    "apifable": "./bin/apifable.mjs"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown",
    "inspect": "npx -y @modelcontextprotocol/inspector node bin/apifable.mjs mcp",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "typecheck": "tsc",
    "test": "vitest",
    "check": "pnpm lint && pnpm fmt --check && pnpm typecheck && pnpm test --run",
    "update-actions": "actionspack update",
    "release": "bumpp --commit \"Release v%s\"",
    "prepare": "simple-git-hooks",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@clack/prompts": "^1.9.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "cac": "^7.1.1",
    "minisearch": "^7.2.0",
    "picocolors": "^1.1.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "actionspack": "^0.1.5",
    "bumpp": "^12.3.0",
    "lint-staged": "^17.6.2",
    "memfs": "^4.80.1",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "simple-git-hooks": "^2.14.0",
    "tsdown": "^0.23.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*": "pnpm fmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "pnpm lint"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.23.0"
}
